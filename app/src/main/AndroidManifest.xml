<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Base">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Base">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Quick Add"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Base.QuickAddOverlay"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <receiver
            android:name=".widget.BalanceQuickAddWidgetProvider"
            android:exported="true"
            android:label="@string/widget_balance_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.arango.base.widget.ACTION_TOGGLE_BALANCE_MASK" />
                <action android:name="com.arango.base.widget.ACTION_REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/balance_quick_add_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CategoryShortcutsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_shortcuts_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.arango.base.widget.ACTION_TOGGLE_BALANCE_MASK" />
                <action android:name="com.arango.base.widget.ACTION_REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/category_shortcuts_widget_info" />
        </receiver>
    </application>

</manifest>
