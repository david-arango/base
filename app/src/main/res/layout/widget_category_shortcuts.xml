<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shortcuts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Main Action Row: + Add Button + Top Category Icons (Icons Only, Monochrome) -->
    <LinearLayout
        android:id="@+id/widget_shortcuts_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_primary_button"
            android:contentDescription="Quick Add Transaction"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Add"
                android:src="@drawable/ic_widget_add" />

            <TextView
                android:id="@+id/widget_add_btn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:text="Add"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_cat_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:contentDescription="Category 1">

            <ImageView
                android:id="@+id/widget_cat_icon_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Category 1" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_cat_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:contentDescription="Category 2">

            <ImageView
                android:id="@+id/widget_cat_icon_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Category 2" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_cat_3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:contentDescription="Category 3">

            <ImageView
                android:id="@+id/widget_cat_icon_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Category 3" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_cat_4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:contentDescription="Category 4">

            <ImageView
                android:id="@+id/widget_cat_icon_4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Category 4" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
